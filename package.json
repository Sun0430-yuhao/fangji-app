{
  "name": "fangji-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pwa": "npm run embed && vite build",
    "preview": "vite preview --host",
    "pwa": "npm run build:pwa && vite preview --host --port 4173",
    "cap:sync": "npm run build:cap && npx cap sync",
    "cap:android": "npm run build:cap && npx cap sync android && npx cap open android",
    "cap:ios": "npm run build:cap && npx cap sync ios && npx cap open ios",
    "embed": "node scripts/gen_embed.mjs",
    "build:cap": "npm run embed && vite build --mode capacitor",
    "apk": "npm run build:cap && npx cap sync android",
    "qa": "node scripts/qa_smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@supabase/supabase-js": "^2.119.0",
    "pinia": "^3.0.3",
    "pinyin-pro": "^3.29.5",
    "vant": "^4.9.21",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright": "^1.65.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3"
  }
}
